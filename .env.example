# Small Pot - server-side secrets for the Netlify functions.
# Copy to .env for local dev (netlify dev reads it). Mirror every value into
# Netlify: Site configuration > Environment variables.

# Resend API key. A "sending access" key is enough (no audiences/broadcasts used).
RESEND_API_KEY=re_xxxxxxxx

# Password for /admin. Sent as "Authorization: Bearer <password>" by the admin page.
ADMIN_PASSWORD=change-me

# Random secret that signs unsubscribe links (openssl rand -hex 32).
NEWSLETTER_SECRET=change-me

# From address. Must be on a domain verified in Resend before sending to anyone
# but the account owner. onboarding@resend.dev only delivers to the Resend
# account's own email.
NEWSLETTER_FROM="Small Pot <onboarding@resend.dev>"
NEWSLETTER_REPLY_TO=

# Public site origin used for the logo, footer link, and unsubscribe links.
# Netlify sets URL automatically in production; only needed locally.
# SITE_URL=http://localhost:8888

# Supabase (Andrew's personal "calendar" project, tables sp_*). Service role, server-side only.
SUPABASE_URL=https://blnzwktmecwgdhmmasxi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
